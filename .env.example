# Copy to .env and fill in. .env is gitignored; THIS file is committed, so it
# must never contain a real value -- see .githooks/pre-commit, which enforces
# that. On GitHub Actions no .env exists at all: the workflow supplies these as
# environment variables and repository secrets, and load_env() uses setdefault
# so a missing .env is a no-op.

# --- Required ---------------------------------------------------------------

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Email (optional; leave unset to skip delivery entirely) -----------------

# Gmail works. Microsoft does NOT: basic authentication was retired and reached
# 100% rejection on 30 April 2026, and an app password *is* basic auth, so an
# Outlook address fails with 535 5.7.3 no matter what password you use. There is
# no password that works; Microsoft requires OAuth2, which this project does not
# implement. Past roughly 100 subscribers, move to Resend or SES -- that is a
# four-line change here and nothing in the code.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The Gmail account doing the sending.
SMTP_USER=you@gmail.com

# A 16-character App Password, NOT your account password. Requires 2-Step
# Verification: https://myaccount.google.com/apppasswords
# Google displays it as four groups of four; the spaces are stripped for you if
# the value matches that exact shape, so pasting it either way works.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Comma-separated. These go in Bcc, never To, so subscribers never see each
# other's addresses. On GitHub this is a SECRET, not workflow config: it is
# other people's addresses.
SMTP_TO=someone@example.com,someone-else@example.com

# Optional; defaults to SMTP_USER.
#SMTP_FROM=you@gmail.com

# --- Presentation (optional) -------------------------------------------------

# Display name on the From: line.
#EMAIL_SENDER_NAME=arXiv Industry Scout

# Prepended to every subject, so the digest stays filterable while the subject
# itself is free to name the specific thing in this week's issue.
#EMAIL_SUBJECT_PREFIX=[quant-ph Scout]

# A URL (rendered as a link, enables Gmail/Apple Mail's one-click Unsubscribe)
# or an address (rendered as "just reply and say so", which is right for a
# hand-managed list). Unset falls back to replying to the sender.
#EMAIL_UNSUBSCRIBE=you@gmail.com

# RFC 2919 list identity, e.g. "quantph-scout.example.com". A positive
# deliverability signal; unset omits the List-Id header rather than inventing
# one. On GitHub this is set in the workflow's env: block, not as a secret.
#EMAIL_LIST_ID=quantph-scout.example.com
